<view class="cend-page">
  <view class="cend-brand">
    <view class="cend-brand-name">宠物看护</view>
    <view class="cend-slogan">随时随地看看你的宠物</view>
  </view>

  <view class="cend-mode">
    <view class="cend-mode-text">
      <view class="cend-mode-title">演示模式</view>
      <view class="cend-mode-desc">无需登录，用示例数据预览完整面板</view>
    </view>
    <switch checked="{{demoMode}}" color="#ff8a4c" disabled="{{loading}}" bindchange="onModeChange" />
  </view>

  <block wx:if="{{!demoMode}}">
    <view class="cend-field">
      <text class="cend-label">手机号</text>
      <input class="cend-input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="cend-ph"
        value="{{phone}}" bindinput="onPhone" disabled="{{loading}}" />
    </view>
    <view class="cend-field">
      <text class="cend-label">密码</text>
      <input class="cend-input" password placeholder="请输入密码" placeholder-class="cend-ph"
        value="{{password}}" bindinput="onPassword" disabled="{{loading}}" />
    </view>
    <view class="cend-field">
      <text class="cend-label">服务器</text>
      <input class="cend-input" type="text" value="{{server}}" bindinput="onServer" bindblur="saveServer"
        bindconfirm="saveServer" disabled="{{loading}}" />
    </view>
  </block>

  <button class="cend-btn primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onPrimary">{{demoMode ? '进入演示面板' : '登录'}}</button>

  <view class="cend-foot" wx:if="{{!demoMode}}">还没有账号？<text class="cend-link" bindtap="goRegister">立即注册</text></view>
</view>
