      "accessMode": "rw",
      "required": false,
      "dataType": "enum",
      "specs": {
        "1": "流畅",
        "2": "标清",
        "3": "高清",
        "4": "超清"
      },
      "description": "实时流的编码画质档位。切换后设备重新协商码流。",
      "sort": 2
    },
    {
      "id": 3,
