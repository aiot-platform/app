      "dataType": "enum",
      "specs": {
        "0": "空闲",
        "1": "推流中",
        "2": "对讲中",
        "3": "异常"
      },
      "description": "设备侧音视频链路状态，只读。推流中表示设备正在向观看端推送音视频流。",
      "sort": 1
